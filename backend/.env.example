# =========================================================================
# Industrial Carbon Intelligence - backend environment
# Copy to backend/.env and fill in. NEVER commit .env.
# All values here are SERVER-SIDE ONLY. Never create VITE_ copies of these.
# =========================================================================

# ---- EPA Clean Air Markets (CAM / CAMPD) ----
# US power-sector program data only. Get a key at https://www.epa.gov/power-sector/cam-api-portal
EPA_API_KEY=

# ---- Electricity Maps ----
# GRID carbon intensity (gCO2eq/kWh) for an electricity zone.
# NOT a facility meter reading. https://portal.electricitymaps.com/
ELECTRICITY_MAPS_API_KEY=
# Default zone used when a facility has no mapped zone (e.g. IN-SO, IN-NO, GB, US-CAL-CISO)
ELECTRICITY_MAPS_DEFAULT_ZONE=IN-SO

# ---- Climatiq ----
# Activity-data -> emissions via emission factors. https://www.climatiq.io/
CLIMATIQ_API_KEY=
CLIMATIQ_DATA_VERSION=^37

# ---- Supabase ----
# Project Settings -> Data API / Database
SUPABASE_URL=
# Publishable key MAY reach the browser, but only with Row Level Security enabled.
SUPABASE_PUBLISHABLE_KEY=
# SECRET key is server-only. NEVER expose this to React.
SUPABASE_SECRET_KEY=
# Postgres connection string. Prefer the Session/Transaction pooler on IPv4 networks.
# postgresql+psycopg://postgres.<ref>:<password>@<host>:5432/postgres
DATABASE_URL=

# ---- Gemini ----
# Explanation layer ONLY. Gemini never performs the optimization.
GEMINI_API_KEY=
# Model id is configurable and must not be hardcoded in source.
GEMINI_MODEL=gemini-2.5-flash
# Tried in order when the primary is overloaded (503), rate-limited (429)
# or missing (404). Leave blank to disable fallback.
# Verify ids against your own key before trusting them - availability
# differs per key, and '-latest' aliases are hot-swapped by Google.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash
GEMINI_ENABLED=false

# ---- App ----
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
LOG_LEVEL=INFO
# Background refresh interval in seconds (0 disables polling)
REFRESH_INTERVAL_SECONDS=0

# ---- Auth ----
# MUST be at least 32 bytes. Generate with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Gate for creating the FIRST platform admin via /api/auth/bootstrap-admin.
# Leave blank in production once the admin exists.
ADMIN_SETUP_KEY=
